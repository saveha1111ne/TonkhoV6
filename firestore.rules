rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in [
          'save.ha1111@gmail.com',
          'admin@cic.com',
          'hanhunglog@cic.com'
        ] ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Transactions collection: Read-only for all, Admin can write
    match /transactions/{transactionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidId(transactionId);
    }

    // Items catalog: Read-only for all, Admin can write
    match /items/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidId(itemId);
    }

    // Branches: Read-only for all, Admin can write
    match /branches/{branchId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidId(branchId);
    }

    // Monthly balances: Read-only for all, Admin can write
    match /monthlyBalances/{balanceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidId(balanceId);
    }

    // System configuration: Read-only for all, Admin can write
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(configId);
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidId(adminId);
    }
  }
}
